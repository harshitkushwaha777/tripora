# ==============================================================================
# Tripora Backend Environment Configuration
# ==============================================================================

# Supabase
SUPABASE_URL=https://your-supabase-project.supabase.co
# Server-side service key (Optional, only needed if elevated server operations are used)
SUPABASE_SERVICE_ROLE_KEY=
# Supabase JWT Secret or public JWKS endpoint for token validation
SUPABASE_JWT_SECRET=

# AI Provider Configuration ('gemini', 'openai', 'anthropic', or 'none')
# If AI_API_KEY is omitted or empty, Tripora will automatically use its built-in
# deterministic fallback engine with clear provenance metadata.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Application Configuration
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
PORT=8000
HOST=0.0.0.0
